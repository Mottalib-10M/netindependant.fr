---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const q = lang === 'en' ? '?lang=en' : '';
const code = `<iframe src="${SITE_URL}/embed/simulateur-auto-entrepreneur/${q}" title="Micro-enterprise calculator" width="100%" height="1100" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
const code2 = `<iframe src="${SITE_URL}/embed/comparateur-statuts/${q}" title="Legal form comparison" width="100%" height="900" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the micro-enterprise calculator free of charge (iframe)" description="Embed the 2026 French micro-enterprise calculator or the legal form comparison on your own site free of charge: iframe code to copy, no cookies, automatic rate updates." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: lang === 'fr' ? 'Accueil' : 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed a calculator</h1>
    <p class="mt-3 text-lg text-navy-700">For expat networks, relocation services, incubators and newsrooms: copy the code once, rates update by themselves.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>Micro-enterprise calculator</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <h2>Legal form comparison</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code2}</code></pre>
    <p set:html={`Terms: the source link under the calculator stays visible, the calculator is not altered, and it is provided without warranty. For the English version add <code>?lang=en</code> to the address. What your readers type stays on their device.`} />
    <p>Questions: see the <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/simulateur-auto-entrepreneur/${q}`} title="Micro-enterprise calculator" width="100%" height="1100" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
