---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'fr';
const q = lang === 'en' ? '?lang=en' : '';
const code = `<iframe src="${SITE_URL}/embed/simulateur-auto-entrepreneur/${q}" title="Simulateur auto-entrepreneur" width="100%" height="1100" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
const code2 = `<iframe src="${SITE_URL}/embed/comparateur-statuts/${q}" title="Comparateur de statuts" width="100%" height="900" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Simulateur auto-entrepreneur à intégrer gratuitement (iframe)" description="Intégrez gratuitement le simulateur auto-entrepreneur 2026 ou le comparateur de statuts sur votre site : code iframe à copier, aucun cookie, mises à jour automatiques." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: lang === 'fr' ? 'Accueil' : 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Intégrer un simulateur</h1>
    <p class="mt-3 text-lg text-navy-700">Pour les couveuses, réseaux d’accompagnement, associations de créateurs et médias : copiez le code, les taux se mettent à jour d’eux-mêmes.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>Simulateur auto-entrepreneur</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <h2>Comparateur de statuts</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code2}</code></pre>
    <p set:html={`Conditions : le lien vers la source reste visible sous le simulateur, le simulateur n’est pas modifié, il est fourni sans garantie. Pour la version anglaise, ajoutez <code>?lang=en</code> à l’adresse. Ce que vos lecteurs saisissent reste sur leur appareil.`} />
    <p>Questions : page <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/simulateur-auto-entrepreneur/${q}`} title="Simulateur auto-entrepreneur" width="100%" height="1100" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
