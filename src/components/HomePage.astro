---
/**
 * Accueil (pilier, RECETTE §5), trame propre au sujet : une réponse chiffrée, le simulateur
 * auto-entrepreneur visible sans défiler, le paragraphe citable replié, puis ce que le simulateur de
 * l'Urssaf ne compte pas, les taux 2026 par activité, la CFE de dix grandes villes (fichier REI),
 * le même chiffre d'affaires dans cinq statuts, les guides par question, le texte et la FAQ.
 */
import PageLayout from '../layouts/PageLayout.astro';
import MicroRechner from './calc/MicroRechner';
import Clamp from './Clamp.astro';
import { HOME } from '../content/home';
import { route, ROUTES, type Locale } from '../i18n/routes';
import { label, groupLabel } from '../i18n/nav';
import { helpers } from '../lib/helpers';
import { P, type SourceKey } from '../lib/engine/params';
import { cfe } from '../lib/engine/cfe';
import { comparer, STATUTS } from '../lib/engine/statuts';
import { PAGES, GROUPS } from '../lib/guides';
import { NOMS } from './calc/StatutsRechner';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { commune } from '../lib/cfe-data';
import cfeDeps from '../data/cfe-departements.json';
interface Props { lang: Locale }
const { lang } = Astro.props;
const fr = lang === 'fr';
const x = HOME[lang];
const h = helpers(lang);
const path = route('home', lang);
const faqs = x.faqs(h);
const keys: SourceKey[] = ['aeEssentiel', 'spCotisationsMicro', 'spPlafonds', 'spMicroImposition', 'impotsVL', 'spFranchiseTva', 'spAcre', 'urssafAcre2026', 'spCfe', 'rei2025', 'spTaxesChambres', 'urssafReforme'];
const sources = keys.map((k) => ({ name: P.sources[k].label[lang], url: P.sources[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(faqs, lang)];
const has = (id: string) => ROUTES.some((r) => r.id === id);
const r = (id: string) => (has(id) ? route(id, lang) : undefined);

// CFE de dix grandes villes, tranche 10 001 à 32 600 € et 32 601 à 100 000 € (fichier REI 2025).
const villes = [['75', '75056'], ['13', '13055'], ['69', '69123'], ['31', '31555'], ['06', '06088'], ['44', '44109'], ['34', '34172'], ['67', '67482'], ['33', '33063'], ['59', '59350']];
const lignesCfe = villes.map(([d, c]) => {
  const v = commune(d, c);
  return { n: v.n, t: v.t, a: cfe(20000, v.t, v.b).total, b: cfe(50000, v.t, v.b).total };
}).sort((p, q) => p.a - q.a);
const NB = cfeDeps.departements.reduce((s, d) => s + d.k, 0);

// Le même chiffre d'affaires dans cinq statuts (moteur).
const cas = [40000, 70000, 100000].map((ca) => ({ ca, r: comparer({ ca, charges: 3000, activite: 'bnc' }) }));
const nom = (s: (typeof STATUTS)[number]) => (fr ? NOMS[s][0] : NOMS[s][1]);

const oublis = fr ? [
  ['La CFE de votre commune', `Base minimum et taux votés par chacune des ${h.num(NB)} communes du fichier de la DGFiP, pour votre tranche de chiffre d’affaires.`],
  ['L’impôt du foyer, pas un taux moyen', 'Barème 2026, quotient familial, décote et revenus du conjoint : l’impôt dû à l’activité, pas une tranche à deviner.'],
  ['Les taux 2026, pas ceux de 2023', `${h.pct(P.micro.taux.bnc, 1)} en libéral et des plafonds de ${h.eur(P.micro.plafonds.services)} et ${h.eur(P.micro.plafonds.vente)} : beaucoup de pages en sont restées à ${h.pct(P.micro.historique_bnc.jusqu_a_2024_06, 1)} et ${h.eur(P.micro.plafonds.anciens_services)}.`],
  ['Le chiffre tout de suite', 'Pas d’e-mail, pas de compte, pas de rendez-vous : le net s’affiche à la première saisie, et rien ne quitte votre navigateur.'],
] : [
  ['Your commune’s CFE', `The minimum base and rate voted by each of the ${h.num(NB)} communes in the DGFiP file, for your turnover band.`],
  ['Your household’s tax, not an average rate', '2026 scale, family shares, low-income discount and your partner’s income: the tax your business actually causes.'],
  ['2026 rates, not 2023 ones', `${h.pct(P.micro.taux.bnc, 1)} for freelancers and ceilings of ${h.eur(P.micro.plafonds.services)} and ${h.eur(P.micro.plafonds.vente)}: many pages still show ${h.pct(P.micro.historique_bnc.jusqu_a_2024_06, 1)} and ${h.eur(P.micro.plafonds.anciens_services)}.`],
  ['The figure straight away', 'No email, no account, no call-back: take-home pay appears on the first entry, and nothing leaves your browser.'],
];
const activites = ['vente', 'bic', 'bnc', 'cipav'] as const;
const actNom = { vente: fr ? 'Vente de marchandises' : 'Selling goods', bic: fr ? 'Services commerciaux, artisanat' : 'Commercial and craft services', bnc: fr ? 'Libéral non réglementé' : 'Unregulated freelance', cipav: fr ? 'Libéral Cipav' : 'Cipav professions' };
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={faqs} sources={sources}>
  <header class="mb-4">
    <h1 class="text-3xl font-bold text-navy-900 md:text-[2.4rem] md:leading-tight">{x.h1}</h1>
    <p class="mt-2 text-lg text-navy-700">{x.lead(h)}</p>
    <p class="mt-1 text-sm text-navy-700">{fr ? 'Taux Urssaf 2026, barème fiscal 2026, CFE votée par la commune' : '2026 Urssaf rates, 2026 tax scale, CFE set by the commune'} · <a class="underline" href={route('method', lang)}>{label('method', lang)}</a> · <a class="underline" href={route('about', lang)}>{label('about', lang)}</a></p>
  </header>
  <section id="simulateur" data-outil aria-label={fr ? 'Simulateur auto-entrepreneur' : 'Micro-enterprise calculator'}>
    <MicroRechner client:load lang={lang} methodHref={route('method', lang)} compareHref={r('comparateur-statuts')} cfeHref={r('cfe-auto-entrepreneur')} />
  </section>
  <section class="mt-8" aria-labelledby="essentiel">
    <h2 id="essentiel" class="sr-only">{fr ? 'L’essentiel' : 'In short'}</h2>
    <Clamp text={x.resume(h)} lang={lang} id="clamp-home" sentences={2} />
  </section>

  <section class="mt-10 border-t border-navy-200 pt-6" aria-labelledby="oublis" data-chrome>
    <h2 id="oublis" class="text-2xl font-bold text-navy-900">{fr ? 'Ce que les autres simulateurs laissent de côté' : 'What other calculators leave out'}</h2>
    <ol class="mt-4 grid gap-x-8 gap-y-4 md:grid-cols-2">
      {oublis.map(([t, d], i) => (
        <li class="flex gap-3"><span class="font-serif text-2xl font-bold text-accent-800" aria-hidden="true">{i + 1}</span><span><span class="block font-semibold text-navy-900">{t}</span><span class="text-sm text-navy-700">{d}</span></span></li>
      ))}
    </ol>
  </section>

  <section class="mt-10 border-t border-navy-200 pt-6" aria-labelledby="taux" data-chrome>
    <h2 id="taux" class="text-2xl font-bold text-navy-900">{fr ? 'Les taux 2026 par activité' : '2026 rates by activity'}</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full min-w-[42rem] text-sm tabular-nums">
        <caption class="mb-2 text-left text-sm text-navy-700">{fr ? 'Autoentrepreneur.urssaf.fr et service-public, relus le 15 octobre 2026' : 'Autoentrepreneur.urssaf.fr and service-public, checked 15 October 2026'}</caption>
        <thead><tr class="border-b-2 border-navy-800 text-left text-navy-900">
          <th scope="col" class="py-2 pr-3">{fr ? 'Activité' : 'Activity'}</th>
          <th scope="col" class="py-2 pr-3 text-right">{fr ? 'Cotisations' : 'Contributions'}</th>
          <th scope="col" class="py-2 pr-3 text-right">{fr ? 'Acre (début avant / depuis juillet 2026)' : 'Acre (start before / since July 2026)'}</th>
          <th scope="col" class="py-2 pr-3 text-right">{fr ? 'Versement libératoire' : 'Flat-rate tax'}</th>
          <th scope="col" class="py-2 pr-3 text-right">{fr ? 'Abattement fiscal' : 'Tax allowance'}</th>
          <th scope="col" class="py-2 text-right">{fr ? 'Plafond de CA' : 'Turnover ceiling'}</th>
        </tr></thead>
        <tbody>
          {activites.map((a) => (
            <tr class="border-b border-navy-200 text-navy-800">
              <th scope="row" class="py-2 pr-3 text-left font-medium">{actNom[a]}</th>
              <td class="py-2 pr-3 text-right">{h.pct(P.micro.taux[a], 1)}</td>
              <td class="py-2 pr-3 text-right">{h.pct(P.micro.acre.taux_acre_avant[a], 1)} / {h.pct(P.micro.acre.taux_acre_depuis[a], 1)}</td>
              <td class="py-2 pr-3 text-right">{h.pct(P.micro.vl[a], 1)}</td>
              <td class="py-2 pr-3 text-right">{h.pct(a === 'vente' ? P.micro.abattement.vente : a === 'bic' ? P.micro.abattement.bic : P.micro.abattement.bnc, 0)}</td>
              <td class="py-2 text-right">{h.eur(a === 'vente' ? P.micro.plafonds.vente : P.micro.plafonds.services)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="mt-10 border-t border-navy-200 pt-6" aria-labelledby="villes" data-chrome>
    <h2 id="villes" class="text-2xl font-bold text-navy-900">{fr ? 'La CFE d’un auto-entrepreneur dans dix grandes villes' : 'A micro-entrepreneur’s CFE in ten large cities'}</h2>
    <p class="mt-2 text-navy-700">{fr ? `Sans local, à partir de la troisième année, pour un chiffre d’affaires de ${h.eur(20000)} puis de ${h.eur(50000)} deux ans plus tôt. Taux et bases minimum votés pour ${P.cfe.millesime_taux} (DGFiP, fichier REI).` : `No business premises, from the third year, for turnover of ${h.eur(20000)} then ${h.eur(50000)} two years earlier. Rates and minimum bases set for ${P.cfe.millesime_taux} (DGFiP, REI file).`}</p>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full min-w-[30rem] text-sm tabular-nums">
        <thead><tr class="border-b-2 border-navy-800 text-left text-navy-900">
          <th scope="col" class="py-2 pr-3">{fr ? 'Commune' : 'Commune'}</th>
          <th scope="col" class="py-2 pr-3 text-right">{fr ? 'Taux global' : 'Overall rate'}</th>
          <th scope="col" class="py-2 pr-3 text-right">{fr ? `CFE, CA de ${h.eur(20000)}` : `CFE, ${h.eur(20000)} turnover`}</th>
          <th scope="col" class="py-2 text-right">{fr ? `CFE, CA de ${h.eur(50000)}` : `CFE, ${h.eur(50000)} turnover`}</th>
        </tr></thead>
        <tbody>{lignesCfe.map((v) => (<tr class="border-b border-navy-200 text-navy-800"><th scope="row" class="py-2 pr-3 text-left font-medium">{v.n}</th><td class="py-2 pr-3 text-right">{h.pct(v.t, 2)}</td><td class="py-2 pr-3 text-right">{h.eur(v.a)}</td><td class="py-2 text-right">{h.eur(v.b)}</td></tr>))}</tbody>
      </table>
    </div>
    {r('cfe-auto-entrepreneur') && <a class="mt-3 inline-block text-sm font-medium text-accent-800 underline" href={r('cfe-auto-entrepreneur')}>{fr ? 'Calculer la CFE de votre commune' : 'Work out the CFE for your commune'}</a>}
  </section>

  <section class="mt-10 border-t border-navy-200 pt-6" aria-labelledby="statuts" data-chrome>
    <h2 id="statuts" class="text-2xl font-bold text-navy-900">{fr ? 'Le même chiffre d’affaires dans cinq statuts' : 'The same turnover under five legal forms'}</h2>
    <p class="mt-2 text-navy-700">{fr ? `Net en poche par mois, libéral, ${h.eur(3000)} de frais par an, personne seule, frais propres à une société non compris.` : `Monthly take-home, freelance profession, ${h.eur(3000)} of expenses a year, single, company running costs not included.`}</p>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full min-w-[36rem] text-sm tabular-nums">
        <thead><tr class="border-b-2 border-navy-800 text-left text-navy-900"><th scope="col" class="py-2 pr-3">{fr ? 'Statut' : 'Legal form'}</th>{cas.map((c) => <th scope="col" class="py-2 pr-3 text-right">{fr ? `CA ${h.eur(c.ca)}` : `${h.eur(c.ca)} turnover`}</th>)}</tr></thead>
        <tbody>{STATUTS.map((s) => (<tr class="border-b border-navy-200 text-navy-800"><th scope="row" class="py-2 pr-3 text-left font-medium">{nom(s)}</th>{cas.map((c) => <td class="py-2 pr-3 text-right">{c.r[s].possible ? h.eur(c.r[s].netMensuel) : (fr ? 'plafond dépassé' : 'over ceiling')}</td>)}</tr>))}</tbody>
      </table>
    </div>
    {r('comparateur-statuts') && <a class="mt-3 inline-block text-sm font-medium text-accent-800 underline" href={r('comparateur-statuts')}>{fr ? 'Comparer avec vos chiffres' : 'Compare with your own figures'}</a>}
  </section>

  <section class="mt-10 border-t border-navy-200 pt-6" aria-labelledby="guides" data-chrome>
    <h2 id="guides" class="text-2xl font-bold text-navy-900">{fr ? 'Une question, un calcul' : 'One question, one calculation'}</h2>
    <div class="mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {GROUPS.map((g) => (<div><p class="font-semibold text-navy-900">{groupLabel(g, lang)}</p><ul class="mt-2 space-y-1 text-sm">{PAGES.filter((p) => p.group === g).map((p) => <li><a class="text-navy-800 underline hover:text-accent-800" href={route(p.id, lang)}>{p[lang].nav}</a></li>)}</ul></div>))}
    </div>
  </section>

  <div class="prose prose-slate mt-10 max-w-none border-t border-navy-200 pt-4">
    <Fragment set:html={x.body(h)} />
  </div>
</PageLayout>
